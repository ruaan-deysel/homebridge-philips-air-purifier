# Copy to .env and fill in. .env is gitignored and must never be committed.
# Only needed for scripts/deploy.sh — the plugin itself reads nothing from here.

# Homebridge UI (host:port) and its login
HOMEBRIDGE_URL=192.168.20.21:8581
HOMEBRIDGE_USER=your-ui-username
HOMEBRIDGE_PASS=your-ui-password

# The Docker host running Homebridge, reached over SSH
UNRAID_HOST=192.168.20.21
UNRAID_USER=root
UNRAID_PASS=your-root-password

# The purifier, used by the probe scripts in scripts/
PURIFIER_HOST=192.168.20.151
